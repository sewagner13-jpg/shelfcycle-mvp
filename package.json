{
  "name": "shelfcycle-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MVP for ShelfCycle-assisted intake, matching, and drafting",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test",
    "netlify:cli": "node scripts/netlify-cli.mjs",
    "netlify:login": "node scripts/netlify-cli.mjs login",
    "deploy:netlify:prod": "node scripts/netlify-cli.mjs deploy --prod",
    "deploy:netlify:prod:build": "node scripts/netlify-cli.mjs deploy --prod --use-build",
    "link-health": "node scripts/link-health-check.mjs",
    "export-knowledge": "node apps/local-sync/export-knowledge.mjs",
    "get-refresh-token": "node apps/local-sync/get-refresh-token.mjs",
    "make-hosted-settings": "node apps/local-sync/make-hosted-settings.mjs",
    "push-knowledge": "node apps/local-sync/push-knowledge.mjs",
    "push-review-actions": "node apps/local-sync/push-review-actions.mjs",
    "push-settings": "node apps/local-sync/push-settings.mjs",
    "local-runner:install-mac": "node apps/local-runner/install-mac-launchd.mjs",
    "local-runner:restart": "node apps/local-runner/install-mac-launchd.mjs --restart",
    "local-runner:status": "node apps/local-runner/install-mac-launchd.mjs --status",
    "local-runner:uninstall": "node apps/local-runner/install-mac-launchd.mjs --uninstall",
    "daily-brief": "node apps/daily-brief/run.mjs",
    "daily-brief:local": "node apps/daily-brief/run-local-scheduled.mjs",
    "daily-brief:install-mac": "node apps/daily-brief/install-mac-launchd.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "latest",
    "@netlify/functions": "latest"
  }
}
